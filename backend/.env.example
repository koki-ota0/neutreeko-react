# Copy to .env and export the values in your shell / hosting provider.
# Comma-separated list of browser origins allowed by CORS. Include the exact
# Vercel production AND preview origins, e.g.
# ALLOWED_ORIGINS=https://my-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional shared secret. When set, POST /save_graph requires the
# X-API-Token header. Set the same value as REACT_APP_API_TOKEN in the frontend.
# API_TOKEN=replace-me

# Optional Redis URL. When unset, graphs are stored in backend/data/*.json.
# REDIS_URL=redis://localhost:6379/0

# Optional cap on persisted graph size (bytes).
# MAX_GRAPH_BYTES=33554432
