# Empty = same-origin requests. The CRA dev server's "proxy" setting in
# package.json forwards /load_graph, /save_graph and /legal_moves/* to the
# backend on port 8000. This avoids CORS and also works in hosted previews.
# Set an absolute URL here only if you want to bypass the proxy.
REACT_APP_API_URL=
# Optional: must match the backend's API_TOKEN when one is configured.
# REACT_APP_API_TOKEN=
