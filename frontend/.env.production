# REACT_APP_API_URL is baked into the bundle at BUILD time.
# Set it in the Vercel project's Environment Variables (or copy .env.example
# to .env.production.local, which is gitignored) before deploying.
# The placeholder below is intentionally invalid: the UI will show a visible
# error rather than silently doing nothing if it is left unchanged.
REACT_APP_API_URL=https://your-backend-url.example.com
# Must match the backend's API_TOKEN if the backend requires one.
# REACT_APP_API_TOKEN=
